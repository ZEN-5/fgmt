	<script>
		/* ============================================================
		 * 1) 스크롤 등장 모션 — 섹션이 화면에 들어오면 .in-view 를 한 번 붙임
		 * ============================================================ */
		const sections = Array.from(document.querySelectorAll<HTMLElement>('.hc2-section'));
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add('in-view');
					io.unobserve(entry.target);
				});
			},
			{ threshold: 0.2 }
		);
		sections.forEach((s) => io.observe(s));

		// 로고 · 퀵메뉴 TOP → 맨 위로 부드럽게 스크롤
		const toTop = (e: Event) => {
			e.preventDefault();
			window.scrollTo({ top: 0, behavior: 'smooth' });
		};
		document.querySelector('[data-goto="0"]')?.addEventListener('click', toTop);
		document.getElementById('hc2-top')?.addEventListener('click', toTop);

		// 비주얼 영상 · 배너 자동재생은 화면에 보일 때만
		const visible = new Map<Element, boolean>();
		const vio = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				visible.set(entry.target, entry.isIntersecting);
				entry.target.dispatchEvent(new CustomEvent('hc2:visible', { detail: entry.isIntersecting }));
			});
		});
		{
			const video = document.getElementById('s1-video') as HTMLVideoElement;
			const band = video.parentElement!;
			vio.observe(band);
			band.addEventListener('hc2:visible', (e) => {
				if ((e as CustomEvent<boolean>).detail) video.play().catch(() => {});
				else video.pause();
			});
		}

		/* ============================================================
		 * 2) 섹션2 우측 배너 슬라이더 (페이드, 자동재생/일시정지)
		 * ============================================================ */
		{
			const root = document.getElementById('s2-banner')!;
			const slides = Array.from(root.querySelectorAll<HTMLElement>('.slide'));
			const currentNum = root.querySelector<HTMLElement>('[data-current]')!;
			const INTERVAL = 4000;
			let idx = 0;
			let timer: number | undefined;
			let paused = false;

			function go(i: number) {
				idx = (i + slides.length) % slides.length;
				slides.forEach((s, n) => s.classList.toggle('active', n === idx));
				currentNum.textContent = String(idx + 1);
				restart();
			}
			function restart() {
				clearInterval(timer);
				if (!paused && visible.get(root)) timer = window.setInterval(() => go(idx + 1), INTERVAL);
			}
			root.querySelector('.prev')!.addEventListener('click', () => go(idx - 1));
			root.querySelector('.next')!.addEventListener('click', () => go(idx + 1));
			root.querySelector('.toggle')!.addEventListener('click', () => {
				paused = !paused;
				root.classList.toggle('paused', paused);
				restart();
			});
			vio.observe(root);
			root.addEventListener('hc2:visible', restart);
		}
	</script>
</DeliveryLayout>
