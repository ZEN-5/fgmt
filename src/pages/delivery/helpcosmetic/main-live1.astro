		/* ============================================================
		 * 1) 패럴럭스 섹션 전환 (taean gunsu1과 동일한 방식)
		 *    휠 1회 = 1섹션, 관성 tail 무시, 전환 중 입력은 대기 후 이어서 처리,
		 *    마지막 섹션에서 한 번 더 내리면 footer까지 애니메이션 스크롤
		 * ============================================================ */
		const track = document.getElementById('hc-track')!;
		const header = document.getElementById('hc-header')!;
		const navi = document.getElementById('hc-navi')!;
		const quick = document.getElementById('hc-quick')!;
		const fixedEl = document.getElementById('hc-fixed')!;
		const spacerEl = document.getElementById('hc-spacer')!;
		const sections = Array.from(document.querySelectorAll<HTMLElement>('.hc-section'));
		const naviButtons = Array.from(navi.querySelectorAll<HTMLButtonElement>('button'));
		const total = sections.length;

		const ANIM_MS = 850;
		const GESTURE_GAP_MS = 150; // 이 시간 이상 조용했다가 다시 들어오면 새 제스처로 간주

		let current = 0;
		let mode: 'locked' | 'free' = 'locked'; // free = footer가 열린 상태
		let animating = false;
		let lastWheelTime = 0;
		let lastDirection = 0;
		let gestureConsumed = false;
		let pendingDirection: number | null = null;
		let revealTimer: number | undefined;

		function applyTheme(i: number) {
			const theme = sections[i].dataset.theme;
			for (const el of [header, navi, quick]) {
				el.classList.toggle('theme-dark', theme === 'dark');
				el.classList.toggle('theme-light', theme === 'light');
			}
			naviButtons.forEach((b, idx) => b.classList.toggle('active', idx === i));
		}

		function triggerReveal(index: number) {
			sections.forEach((s, i) => {
				if (i === index) {
					// 재방문 시에도 모션이 다시 재생되도록 클래스를 뗐다 붙인다
					s.classList.remove('in-view');
					void s.offsetWidth;
					s.classList.add('in-view');
				} else {
					s.classList.remove('in-view');
				}
			});
			document.dispatchEvent(new CustomEvent('hc:section', { detail: index }));
		}

		function goTo(index: number) {
			current = Math.max(0, Math.min(total - 1, index));
			track.style.transform = `translateY(-${current * 100}vh)`;
			applyTheme(current);
			// 트랙 전환이 끝난 뒤 텍스트 모션 시작
			clearTimeout(revealTimer);
			const revealIndex = current;
			revealTimer = window.setTimeout(() => triggerReveal(revealIndex), ANIM_MS);
		}

		function freeBoundaryY() {
			const spacerTop = spacerEl.getBoundingClientRect().top + window.scrollY;
			return spacerTop + spacerEl.offsetHeight - window.innerHeight;
		}

		const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

		function tweenScrollTo(fromY: number, toY: number, duration: number, onDone?: () => void) {
			let start: number | null = null;
			function frame(ts: number) {
				if (start === null) start = ts;
				const t = Math.min(1, (ts - start) / duration);
				window.scrollTo(0, fromY + (toY - fromY) * easeInOutCubic(t));
				if (t < 1) requestAnimationFrame(frame);
				else onDone?.();
			}
			requestAnimationFrame(frame);
		}

		function afterStep() {
			animating = false;
			if (pendingDirection !== null) {
				const dir = pendingDirection;
				pendingDirection = null;
				step(dir);
			}
		}

		function goFooter() {
			animating = true;
			mode = 'free';
			const boundaryY = freeBoundaryY();
			fixedEl.classList.add('is-free');
			window.scrollTo(0, boundaryY);
			const maxY = document.documentElement.scrollHeight - window.innerHeight;
			tweenScrollTo(boundaryY, maxY, ANIM_MS, afterStep);
		}

		function backFromFooter() {
			animating = true;
			tweenScrollTo(window.scrollY, freeBoundaryY(), ANIM_MS, () => {
				fixedEl.classList.remove('is-free');
				mode = 'locked';
				window.scrollTo(0, 0);
				afterStep();
			});
		}

		function jumpTo(idx: number) {
			if (mode !== 'locked') {
				mode = 'locked';
				fixedEl.classList.remove('is-free');
				window.scrollTo(0, 0);
			} else if (animating || idx === current) {
				return;
			}
			animating = true;
			goTo(idx);
			window.setTimeout(() => (animating = false), ANIM_MS);
		}

		function step(direction: number) {
			if (direction > 0) {
				if (mode === 'free') return;
				if (current >= total - 1) return goFooter();
				animating = true;
				goTo(current + 1);
				window.setTimeout(afterStep, ANIM_MS);
			} else {
				if (mode === 'free') return backFromFooter();
				if (current <= 0) return;
				animating = true;
				goTo(current - 1);
				window.setTimeout(afterStep, ANIM_MS);
			}
		}

		function request(direction: number) {
			if (animating) pendingDirection = direction;
			else step(direction);
		}

		window.addEventListener(
			'wheel',
			(e) => {
				e.preventDefault();
				const direction = Math.sign(e.deltaY);
				if (direction === 0) return;

				const now = Date.now();
				// 조용했다가 다시 들어왔거나 방향이 뒤집히면 새 제스처
				if (now - lastWheelTime >= GESTURE_GAP_MS || direction !== lastDirection) gestureConsumed = false;
				lastWheelTime = now;
				lastDirection = direction;

				if (gestureConsumed) return; // 관성 tail 무시
				gestureConsumed = true;
				request(direction);
			},
			{ passive: false }
		);

		window.addEventListener('keydown', (e) => {
			if ((e.target as HTMLElement).closest('input, textarea')) return;
			if (['ArrowDown', 'PageDown', ' '].includes(e.key)) {
				e.preventDefault();
				request(1);
			} else if (['ArrowUp', 'PageUp'].includes(e.key)) {
				e.preventDefault();
				request(-1);
			}
		});

		// 터치(태블릿) 스와이프
		let touchStartY: number | null = null;
		window.addEventListener('touchstart', (e) => (touchStartY = e.touches[0].clientY), { passive: true });
		window.addEventListener(
			'touchmove',
			(e) => {
				if (touchStartY === null) return;
				e.preventDefault();
				const dy = touchStartY - e.touches[0].clientY;
				if (Math.abs(dy) > 40) {
					request(Math.sign(dy));
					touchStartY = null;
				}
			},
			{ passive: false }
		);

		naviButtons.forEach((b) => b.addEventListener('click', () => jumpTo(Number(b.dataset.index))));
		document.querySelector('[data-goto="0"]')?.addEventListener('click', (e) => {
			e.preventDefault();
			jumpTo(0);
		});

		window.scrollTo(0, 0);
		/* 히어로 타이틀 2줄 세트 교체 반복 — 섹션1에 있을 때만 동작, 재진입 시 첫 세트부터 다시
		 *  1세트 등장 → 2초 유지 → 2세트로 크로스페이드 → 5초 유지 → 1세트로 크로스페이드 → 반복 */
		{
			const sets = Array.from(document.querySelectorAll<HTMLElement>('#s1-title .title-set'));
			const HOLD_MS = [2000, 5000]; // 세트별 유지 시간 (등장 모션 ~1.1s 이후부터)
			const IN_MS = 1100; // 등장 모션 길이 (0.9s + 2번째 줄 지연 0.18s)
			const OVERLAP_MS = 350; // 이전 세트가 사라지기 시작하고 다음 세트가 등장하기까지 간격
			let idx = 0;
			let timer: number | undefined;

			// 클래스 교체만으로 애니메이션이 바뀌므로 중간에 숨김 프레임이 생기지 않음
			function setState(el: HTMLElement, state: 'in' | 'out' | 'hidden') {
				el.classList.toggle('is-in', state === 'in');
				el.classList.toggle('is-out', state === 'out');
				if (state === 'in') el.removeAttribute('aria-hidden');
				else el.setAttribute('aria-hidden', 'true');
			}
			function schedule() {
				timer = window.setTimeout(next, IN_MS + HOLD_MS[idx % HOLD_MS.length]);
			}
			function next() {
				setState(sets[idx], 'out');
				idx = (idx + 1) % sets.length;
				timer = window.setTimeout(() => {
					setState(sets[idx], 'in');
					schedule();
				}, OVERLAP_MS);
			}
			document.addEventListener('hc:section', (e) => {
				clearTimeout(timer);
				sets.forEach((el) => setState(el, 'hidden'));
				idx = 0;
				if ((e as CustomEvent<number>).detail !== 0) return;
				void sets[0].offsetWidth; // 재진입 시 등장 모션 재시작
				setState(sets[0], 'in');
				schedule();
			});
		}

		// 배경 영상은 섹션1에 있을 때만 재생 (다른 섹션에서는 일시정지해 리소스 절약)
		{
			const video = document.getElementById('s1-video') as HTMLVideoElement;
			document.addEventListener('hc:section', (e) => {
				if ((e as CustomEvent<number>).detail === 0) video.play().catch(() => {});
				else video.pause();
			});
		}

		applyTheme(0);
		triggerReveal(0);

		/* ============================================================
		 * 2) 섹션2 해외 법령 카드 슬라이더 (4개 노출, 1칸씩 이동)
		 * ============================================================ */
		{
			const root = document.getElementById('s2-slider')!;
			const trackEl = root.querySelector<HTMLElement>('.s2-track')!;
			const cards = Array.from(trackEl.children) as HTMLElement[];
			const prev = root.querySelector<HTMLButtonElement>('.prev')!;
			const next = root.querySelector<HTMLButtonElement>('.next')!;
			const VISIBLE = 4;
			const GAP = 24;
			let idx = 0;
			const maxIdx = Math.max(0, cards.length - VISIBLE);

			function render() {
				const w = cards[0].offsetWidth + GAP;
				trackEl.style.transform = `translateX(-${idx * w}px)`;
				prev.disabled = idx === 0;
				next.disabled = idx === maxIdx;
			}
			prev.addEventListener('click', () => {
				idx = Math.max(0, idx - 1);
				render();
			});
			next.addEventListener('click', () => {
				idx = Math.min(maxIdx, idx + 1);
				render();
			});
			window.addEventListener('resize', render);
			render();
		}

		/* ============================================================
		 * 3) 섹션3/4 카드 캐러셀 (3장 노출, 1장씩 왼쪽으로 슬라이드, 무한 루프 + 자동재생/일시정지)
		 *    앞쪽 3장을 뒤에 복제해 두고, 끝(복제본 위치)에 도달하면 transition 없이 처음으로 되돌린다.
		 * ============================================================ */
		function setupCarousel(carouselId: string, pagerKey: string, sectionIndex: number) {
			const carousel = document.getElementById(carouselId)!;
			const trackEl = carousel.querySelector<HTMLElement>('.carousel-track')!;
			const cards = Array.from(trackEl.children) as HTMLElement[];
			const total = cards.length;
			const VISIBLE = 3;
			cards.slice(0, VISIBLE).forEach((c) => {
				const clone = c.cloneNode(true) as HTMLElement;
				clone.setAttribute('aria-hidden', 'true');
				clone.tabIndex = -1;
				trackEl.appendChild(clone);
			});
			const pager = document.querySelector<HTMLElement>(`[data-carousel="${pagerKey}"]`)!;
			const currentNum = pager.querySelector<HTMLElement>('[data-current]')!;
			const INTERVAL = 4000;
			const MOVE_MS = 700;
			let idx = 0;
			let moving = false;
			let timer: number | undefined;
			let paused = false;

			const stepPx = () => cards[0].offsetWidth + (parseFloat(getComputedStyle(trackEl).columnGap) || 0);
			const pad2 = (n: number) => String(n).padStart(2, '0');

			function setPos(animate: boolean) {
				trackEl.classList.toggle('animate', animate);
				trackEl.style.transform = `translateX(-${idx * stepPx()}px)`;
				currentNum.textContent = pad2((idx % total) + 1);
			}
			function go(dir: number) {
				if (moving) return;
				moving = true;
				if (dir < 0 && idx === 0) {
					// 처음에서 이전: 복제본 위치(= 처음과 같은 모습)로 순간 이동 후 한 칸 뒤로
					idx = total;
					setPos(false);
					void trackEl.offsetWidth;
				}
				idx += dir;
				setPos(true);
				window.setTimeout(() => {
					if (idx >= total) {
						idx -= total;
						setPos(false);
					}
					moving = false;
				}, MOVE_MS);
				restart();
			}
			function restart() {
				clearInterval(timer);
				// 해당 섹션이 화면에 있을 때만 자동재생
				if (!paused && current === sectionIndex) timer = window.setInterval(() => go(1), INTERVAL);
			}
			const render = () => setPos(false);

			pager.querySelector('.prev')!.addEventListener('click', () => go(-1));
			pager.querySelector('.next')!.addEventListener('click', () => go(1));
			pager.querySelector('.toggle')!.addEventListener('click', () => {
				paused = !paused;
				pager.classList.toggle('paused', paused);
				restart();
			});
			document.addEventListener('hc:section', restart);
			window.addEventListener('resize', render);
			render();
		}

		setupCarousel('s3-carousel', 's3', 2);
		setupCarousel('s4-carousel', 's4', 3);

		/* ============================================================
		 * 4) 섹션4 타이틀 뒤 회전 지구 (canvas 2D)
		 *    위경도 격자선 + 위도선을 따라 찍힌 대륙 점, 북극 쪽으로 기울여 천천히 자전
		 *    대륙 데이터: world-atlas land-110m → 1° 비트마스크(land-mask.json)
		 * ============================================================ */
		{
			const canvas = document.getElementById('s4-globe') as HTMLCanvasElement;
			const ctx = canvas.getContext('2d')!;
			const SIZE = 1600;
			const R = 680;
			const TILT = (24 * Math.PI) / 180; // 북극이 보이도록 앞으로 기울임
			const SPEED = 0.00006; // rad/ms
			const LINE = '#f0f0f0';
			const DOT = [240, 240, 240];
			const deg = Math.PI / 180;
			const cosT = Math.cos(TILT);
			const sinT = Math.sin(TILT);

			const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
			canvas.width = SIZE * dpr;
			canvas.height = SIZE * dpr;
			ctx.scale(dpr, dpr);

			// 구면좌표(위도, 경도) → 화면좌표 + 깊이(z > 0 이면 앞면)
			function project(lat: number, lon: number, spin: number) {
				const cl = Math.cos(lat);
				const x = cl * Math.sin(lon + spin);
				const y = Math.sin(lat);
				const z0 = cl * Math.cos(lon + spin);
				const y1 = y * cosT - z0 * sinT;
				const z1 = y * sinT + z0 * cosT;
				return [SIZE / 2 + R * x, SIZE / 2 - R * y1, z1];
			}

			// 대륙 점: 2.5° 간격 위도선마다, 적도 기준 1.2° 간격으로 배치 (고위도는 간격 보정)
			let dots: [number, number][] = [];
			fetch(canvas.dataset.mask!)
				.then((r) => r.json())
				.then(({ w, h, data }: { w: number; h: number; data: string }) => {
					const bits = Uint8Array.from(atob(data), (c) => c.charCodeAt(0));
					const land = (lat: number, lon: number) => {
						const j = Math.min(h - 1, Math.floor(90 - lat));
						const i = Math.min(w - 1, Math.floor(lon + 180));
						const k = j * w + i;
						return (bits[k >> 3] >> (k & 7)) & 1;
					};
					for (let lat = -87.5; lat <= 87.5; lat += 2.5) {
						const step = 1.2 / Math.max(Math.cos(lat * deg), 0.15);
						for (let lon = -180; lon < 180; lon += step) {
							if (land(lat, lon)) dots.push([lat * deg, lon * deg]);
						}
					}
					draw(performance.now());
				});

			function strokePath(points: number[][]) {
				// 앞면 구간만 이어서 그림
				let drawing = false;
				ctx.beginPath();
				for (const [x, y, z] of points) {
					if (z > 0) {
						if (drawing) ctx.lineTo(x, y);
						else ctx.moveTo(x, y);
						drawing = true;
					} else drawing = false;
				}
				ctx.stroke();
			}

			function draw(t: number) {
				const spin = t * SPEED;
				ctx.clearRect(0, 0, SIZE, SIZE);

				// 격자선: 위도 15°, 경도 15° 간격
				ctx.strokeStyle = LINE;
				ctx.lineWidth = 1;
				for (let lat = -75; lat <= 75; lat += 15) {
					const pts = [];
					for (let lon = 0; lon <= 360; lon += 3) pts.push(project(lat * deg, lon * deg, spin));
					strokePath(pts);
				}
				for (let lon = 0; lon < 360; lon += 15) {
					const pts = [];
					for (let lat = -90; lat <= 90; lat += 3) pts.push(project(lat * deg, lon * deg, spin));
					strokePath(pts);
				}

				// 대륙 점: 가장자리로 갈수록 옅게
				for (const [lat, lon] of dots) {
					const [x, y, z] = project(lat, lon, spin);
					if (z <= 0.02) continue;
					ctx.fillStyle = `rgba(${DOT[0]}, ${DOT[1]}, ${DOT[2]}, ${(0.5 + z * 0.5).toFixed(3)})`;
					ctx.fillRect(x - 1.2, y - 1.2, 2.4, 2.4);
				}
			}

			// 섹션4가 화면에 있을 때만 애니메이션
			let raf = 0;
			function loop(t: number) {
				draw(t);
				raf = requestAnimationFrame(loop);
			}
			document.addEventListener('hc:section', (e) => {
				cancelAnimationFrame(raf);
				if ((e as CustomEvent<number>).detail === 3) raf = requestAnimationFrame(loop);
			});
		}
	</script>
</DeliveryLayout>
